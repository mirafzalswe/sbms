# ============================================================
# UCELL SBMS API - Test Configuration (EXAMPLE)
# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env
# ============================================================

# --- SBMS ---
SBMS_BASE_URL=https://sbms.ucell
SBMS_LOGIN=your.login
SBMS_PASSWORD=your_password

# --- TME (Trouble Management Engine) ---
TME_BASE_URL=https://tme.billing.domain

# --- Тесты ---
TEST_MSISDN=998000000000
REQUEST_TIMEOUT=30

# --- Сервер ---
SERVER_PORT=5000
# FLASK_DEBUG=0   # 1 — только для разработки
